# Client applications
android-client/
client/
ios-client/

# Frontend source (npm package serves compiled build/)
src/
public/

# Documentation
docs/

# Tests and dev tools
test/
tools/
scripts/

# Runtime config (generated at runtime)
config.json
config_backup.json
# 临时凭据（7 天有效，含明文用户名/密码）
temp_credentials.json
# 认证豁免临时白名单（内置那份 auth_bypass_hosts.json 需要随包分发）
temp_auth_bypass_hosts.json
# MITM 规则的运行时持久化数据
proxy/mitm/persistentStore.json
certificates/

# TLS cert & private key (runtime-generated by cert/generator.js, never publish)
cert/socks5_tls.key
cert/socks5_tls.crt

# MITM 根证书私钥（本地生成，绝不发布；泄露即可伪造任意站点）
cert/rootCA.key
cert/rootCA.crt
# 有域名证书的私钥目录（如 cert/yui_cool/privkey.pem）
cert/yui_cool/

# Build / CI
Dockerfile
docker-compose*
.go-cache/
.go-mod-cache/

# Internal / agent configs
.agents/
.claude/
skills-lock.json
.pi/
.qoder/

# Build tools config (build/ already contains compiled output)
craco.config.js
.dockerignore
.eslintignore
.gitmodules
pnpm-workspace.yaml

# Dev configs
.env
.env.*
.eslintrc*
.prettierrc*
AGENTS.md
CLAUDE.md

# Test scripts bundled inside socks5/
socks5/test_tls_reuse.js
socks5/ticket-keys.bin

# Package manager lock files (npm uses package-lock.json at install time)
pnpm-lock.yaml
yarn.lock

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.gitignore
.gitattributes

# GitHub
.github/

# Python（litellm_custom_provider 与代理无关，且 __pycache__ 会带本机绝对路径）
litellm_custom_provider/
__pycache__/
*.pyc

# Misc
*.log
npm-debug.log*
